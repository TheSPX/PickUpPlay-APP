{
  "expo": {
    "name": "PickupPlay",
    "slug": "pickupplay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pickupplay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#001645",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "package": "com.spoox.pickupplay",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#001645",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PickupPlay to access your photos to set a profile picture.",
          "cameraPermission": "Allow PickupPlay to access your camera to take a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#001645"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow PickupPlay to count your steps for Daily Quests."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e643082a-b94c-4225-8244-867225ca8b0c"
      }
    }
  }
}
